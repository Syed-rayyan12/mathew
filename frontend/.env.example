# Backend API the frontend talks to
NEXT_PUBLIC_API_URL=https://mathew-production.up.railway.app/api

# --- Newsletter subscriptions (Resend) ---
# Used by app/api/subscribe/route.ts. Server-side only — do NOT prefix with
# NEXT_PUBLIC_, that would expose the key in the browser bundle.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Segment IDs from the Resend dashboard (Audience -> Segments -> open one; the
# id is the segmentId in the URL). Segments replaced Audiences in Resend.
# Subscribers are added to one or the other based on the family/nursery choice
# on the form. Set both to the same ID if you'd rather keep a single list.
RESEND_SEGMENT_FAMILY_ID=
RESEND_SEGMENT_NURSERY_ID=

# Notification email sent on each signup. Both are optional — leave them blank
# and subscribers are still added to the segment, just with no heads-up email.
# The "from" domain must be verified in Resend.
RESEND_FROM="My Nursery <hello@my-nursery.co.uk>"
RESEND_NOTIFY_TO=help@my-nursery.co.uk

# Launch offer — six free months. Cosmetic gate on the homepage CTA only; the
# backend's OFFER_ENDS_AT decides eligibility. The two dates must match.
NEXT_PUBLIC_OFFER_ENDS_AT=2026-12-31T23:59:59Z
